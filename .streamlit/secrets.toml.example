# Copy this file to `.streamlit/secrets.toml` and fill it in.
#
# The deployment reads this file (or the hosting platform's Secrets section) and
# supplies the key itself, so that a visitor to the demo never needs one of their
# own. `.streamlit/secrets.toml` is gitignored: never commit a real key.

GEMINI_API_KEY = "your-key-here"

# Optional. Defaults to DEFAULT_MODEL in heartrisk/llm.py.
# GEMINI_MODEL = "gemini-2.5-flash"
